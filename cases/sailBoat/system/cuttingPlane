cuttingPlane
{
    type            surfaces;
    libs            (sampling);
    writeControl    writeTime;

    surfaceFormat   vtk;
    fields          ( p U );

    interpolationScheme cellPoint;

    surfaces
    {
        //- Vertical centreline plane through mast and sails
        yNormal
        {
            type        cuttingPlane;
            point       (0 0 0);
            normal      (0 1 0);
            interpolate true;
        }

        //- Horizontal plane at mid-sail height
        zMidSail
        {
            type        cuttingPlane;
            point       (0 0 1.75);
            normal      (0 0 1);
            interpolate true;
        }
    }
}


