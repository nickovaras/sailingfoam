FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

// Domain: x -12..+18 (inlet->outlet), y -6..+6, z -4..+8
// Rig occupies x 0.5..4.1, z -0.1..3.7 (flat trim); boxes below allow heel to ~30 deg

vertices
(
    (-5  -6  -4)   // 0
    (  14  -6  -4)   // 1
    (  14   6  -4)   // 2
    (-5   6  -4)   // 3
    (-5  -6   8)   // 4
    (  14  -6   8)   // 5
    (  14   6   8)   // 6
    (-5   6   8)   // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (32 20 20) simpleGrading (1 1 1)    // 0.6 m base cells
);

boundary
(
    inlet
    {
        type            patch;
        faces           ((0 4 7 3));           // x = -12
    }
    outlet
    {
        type            patch;
        faces           ((1 2 6 5));           // x = +18
    }
    bottom
    {
        type            wall;                  // or slip (see note)
        faces           ((0 3 2 1));           // z = -4
    }
    top
    {
        type            wall;
        faces           ((4 5 6 7));           // z = +8
    }
    sidePort
    {
        type            wall;
        faces           ((0 1 5 4));           // y = -6
    }
    sideStar
    {
        type            wall;
        faces           ((3 7 6 2));           // y = +6
    }
);
