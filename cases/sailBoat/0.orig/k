FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

//- Turbulent kinetic energy: I=5% at U=15 m/s -> k = 1.5*(I*U)^2
internalField   uniform 0.84;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            fixedValue;
        value           $internalField;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }

    bottom
    {
        type            zeroGradient;
    }

    top
    {
        type            zeroGradient;
    }

    sidePort
    {
        type            zeroGradient;
    }

    sideStar
    {
        type            zeroGradient;
    }

    mast
    {
        type            kqRWallFunction;
        value           $internalField;
    }

    mainsail
    {
        type            kqRWallFunction;
        value           $internalField;
    }

    headsail
    {
        type            kqRWallFunction;
        value           $internalField;
    }
}


